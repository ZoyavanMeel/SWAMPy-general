configfile: "config.yaml"

import os
import random
import numpy as np

VIRUS_NAME = config["virus"]
VIRUS_DICT = config[VIRUS_NAME]

if config["cli_c"] != "empty":
    VIRUS_DICT["c"] = config["cli_c"]
if config["cli_v"] != "empty":
    VIRUS_DICT["v"] = config["cli_v"]
if config["cli_b"] != "empty":
    VIRUS_DICT["b"] = config["cli_b"]
if config["cli_decay"] != "empty":
    VIRUS_DICT["decay"] = config["cli_decay"]


N_THRESH = 0.05
# FASTA_DIR = "../Master-Thesis-Project/data/consensus"


def get_sample_names_from_consensus_fastas(wildcards: dict) -> list[str]:
    lst = []
    with open(f"../Master-Thesis-Project/data/n_percentage_consensus/n_percentage_{VIRUS_DICT['consensus_set']}.tsv") as fh:
        for line in fh.readlines():
            accession, percentage = line.strip().split("\t")
            if float(percentage) <= N_THRESH:
                lst.append(accession)
    return lst


rule all:
    input:
        expand(
            "../Master-Thesis-Project/data/fastq_files/{virus}/{sample}_{orient}.fastq",
            sample=get_sample_names_from_consensus_fastas,
            orient=[1, 2],
            virus=[VIRUS_NAME]
        )

rule simulate_single_sample:
    input:
        primer_fastq=f"../Master-Thesis-Project/data/primer_fastqs/{VIRUS_DICT['primers']}.fastq",
        primer_bed=f"../Master-Thesis-Project/data/primer_beds/{VIRUS_DICT['primers']}.bed",
        sample_genome=f"../Master-Thesis-Project/data/consensus/{VIRUS_DICT['consensus_set']}/{{sample}}.fa",
        index_f=f"../Master-Thesis-Project/data/index/{VIRUS_DICT['reference_name']}.bwt",
        ref=f"../Master-Thesis-Project/data/reference_sequences/{VIRUS_DICT['reference_name']}.fasta",
        sample_abundance=f"abundances/{VIRUS_NAME}/{{sample}}.tsv"
    output:
        fw=f"../Master-Thesis-Project/data/fastq_files/{VIRUS_NAME}/{{sample}}_1.fastq",
        rv=f"../Master-Thesis-Project/data/fastq_files/{VIRUS_NAME}/{{sample}}_2.fastq"
    params:
        idx_base=f"../Master-Thesis-Project/data/index/{VIRUS_DICT['reference_name']}",
        output_dir=f"simulation_output/{VIRUS_NAME}/{{sample}}",
        c=VIRUS_DICT["c"],
        v=VIRUS_DICT["v"],
        b=VIRUS_DICT["b"],
        decay=VIRUS_DICT["decay"],
        n_min=VIRUS_DICT['min_reads'],
        n_max=VIRUS_DICT['max_reads'],
        score_thresh=VIRUS_DICT['score_thresh'],
        drop_mean=VIRUS_DICT['drop_mean'],
        drop_std=VIRUS_DICT['drop_std'],
        pcr_err=VIRUS_DICT['pcr_err'],
        vaf=""  # "--subs_VAF_alpha '9.28,0.945' --del_VAF_alpha '4.72,0.41' --ins_VAF_alpha '2.64,0.45'"
    group:
        "simulation_group"
    log:
        f"logs/simulate/{VIRUS_NAME}/{{sample}}.log"
    shell:
        """
        python src/simulate_metagenome.py \
            --primer_set c \
            --reference {input.ref} \
            --primers_file {input.primer_fastq} \
            --primer_bed {input.primer_bed} \
            --genomes_file {input.sample_genome} \
            --index_base {params.idx_base} \
            --genome_abundances {input.sample_abundance} \
            --output_filename_prefix {wildcards.sample} \
            --output_folder {params.output_dir} \
            --temp_folder "temp/{wildcards.sample}/" \
            --snv_balance {params.b} \
            -c {params.c} -v {params.v} \
            --decay_const {params.decay} \
            --score_threshold {params.score_thresh} \
            --dropout_mean {params.drop_mean} \
            --dropout_std {params.drop_std} \
            --autoremove {params.pcr_err} \
            -n $(python -c "import random, re; random.seed(int(re.search(r'(\\d+)$', '{wildcards.sample}').group())); print(random.randint({params.n_min}, {params.n_max}))") \
            --seqSys MS \
            --no_align warn {params.vaf} 2> {log}
        if [ ! -f {params.output_dir}/{wildcards.sample}_R1.fastq ]; then
            touch {params.output_dir}/{wildcards.sample}_R1.fastq
            touch {params.output_dir}/{wildcards.sample}_R2.fastq
        fi
        mv {params.output_dir}/{wildcards.sample}_R1.fastq {output.fw}
        mv {params.output_dir}/{wildcards.sample}_R2.fastq {output.rv}
        """

rule make_abundance_file_single_genome:
    input:
        genome=f"../Master-Thesis-Project/data/consensus/{VIRUS_DICT['consensus_set']}/{{sample}}.fa"
    output:
        f"abundances/{VIRUS_NAME}/{{sample}}.tsv"
    group:
        "simulation_group"
    run:
        with open(input["genome"], "r") as readh:
            name = readh.readline().strip(">\n")
            with open(output[0], "w") as writeh:
                writeh.write(f"{name}\t1.0")